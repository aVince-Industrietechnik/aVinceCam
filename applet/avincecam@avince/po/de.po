msgstr "Details: %s"

#: applet.js:823
msgid "Querying details …"
msgstr "Details werden abgefragt …"

#: applet.js:828
msgid "Query sizes and frame rates (switches the cameras on briefly)"
msgstr "Größen und Bildraten abfragen (schaltet die Kameras kurz ein)"

#: applet.js:829

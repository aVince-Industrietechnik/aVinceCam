{
    "head-appearance": {
        "type": "header",
        "description": "Appearance"
    },
    "panel-icon-style": {
        "type": "combobox",
        "default": "color",
        "description": "Panel icon",
        "options": {
            "Colourful": "color",
            "Single colour (follows the theme)": "symbolic"
        }
    },
    "panel-icon-size-color": {
        "type": "combobox",
        "default": 28,
        "description": "Panel icon size",
        "tooltip": "Never larger than the panel allows.",
        "dependency": "panel-icon-style=color",
        "options": {
            "Like the panel": 0,
            "20 px": 20,
            "24 px": 24,
            "28 px": 28,
            "32 px": 32,
            "36 px": 36
        }
    },
    "panel-icon-size-symbolic": {
        "type": "combobox",
        "default": 24,
        "description": "Panel icon size",
        "tooltip": "Never larger than the panel allows.",
        "dependency": "panel-icon-style=symbolic",
        "options": {
            "Like the panel": 0,
            "16 px": 16,
            "20 px": 20,
            "24 px": 24,
            "28 px": 28,
            "32 px": 32
        }
    },
    "head-preview": {
        "type": "header",
        "description": "Preview"
    },
    "preview-viewer": {
        "type": "combobox",
        "default": "qcam",
        "description": "Preview program",
        "tooltip": "For libcamera cameras. USB cameras use VLC if it is installed, otherwise GStreamer.",
        "options": {
            "qcam (libcamera)": "qcam",
            "GStreamer": "gst"
        }
    },
    "head-photo": {
        "type": "header",
        "description": "Photo"
    },
    "snapshot-size": {
        "type": "combobox",
        "default": "1600x1200",
        "description": "Photo size",
        "tooltip": "The camera is soft at full size; 1600 × 1200 keeps all its detail in a smaller file.",
        "options": {
            "1024 × 768": "1024x768",
            "1600 × 1200 (recommended)": "1600x1200",
            "2048 × 1536": "2048x1536",
            "2560 × 1920 (full size)": "2560x1920"
        }
    },
    "snapshot-folder": {
        "type": "filechooser",
        "select-dir": true,
        "default": "",
        "description": "Folder for photos",
        "tooltip": "Empty: the pictures folder, subfolder aVinceCam."
    },
    "active-indicator": {
        "type": "combobox",
        "default": "rotate",
        "description": "Panel icon while a preview runs",
        "options": {
            "Turn slowly": "rotate",
            "Pulse with a red dot": "pulse",
            "No change": "off"
        }
    },
    "usage-indicator": {
        "type": "switch",
        "default": true,
        "description": "Show when a program uses a camera",
        "tooltip": "Red dot on the panel icon and a line in the menu. aVinceCam only watches the camera device files; it does not open them."
    },
    "allow-lens-cameras": {
        "type": "switch",
        "default": false,
        "description": "Allow preview of cameras with a focus motor",
        "tooltip": "While such a camera streams, libcamera drives its focus motor automatically. Leave this off if the focus motor does not work properly."
    },
    "selected-camera": {
        "type": "generic",
        "default": ""
    }
}

#!/usr/bin/env python3
"""Start the aVinceCam core from its own directory.

Frontends run this file as `python3 -I <dir>/avincecam-core <command>`.
Isolated mode (-I) ignores PYTHONPATH and the user's site-packages, so the
package directory next to this file is added explicitly - nothing else.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from avincecam.__main__ import main  # noqa: E402

sys.exit(main())

"""Stand-in for the aVinceCam core, for applet tests without a camera.

Usage: avincecam-core-fake --scenario=NAME <core arguments...>

Scenarios built on the real core with simulated sysfs trees and recorded
`cam` output (no device is ever touched):
  latitude   Intel IPU3 2-in-1 with front and back camera
  uvc        one external USB webcam
  mixed      IPU3 cameras plus a USB webcam
  empty      no camera at all

Scenarios for error handling:
  slow       answers after 30 seconds (the applet must time out)
  garbage    prints text that is not JSON
  crash      exits with code 1 and a message on stderr
  toolmissing  probe reports that the libcamera tools are missing
"""

import contextlib
import io
import json
import os
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
sys.path.insert(0, os.path.join(REPO, "core"))
sys.path.insert(0, os.path.join(REPO, "tests", "unit"))

os.environ["AVINCECAM_NO_HARDWARE"] = "1"

import fakesysfs  # noqa: E402
from avincecam.__main__ import main as core_main  # noqa: E402

FIXTURES = os.path.join(REPO, "tests", "fixtures", "cam-0.2.0")
SCENARIOS = {
    "latitude": fakesysfs.latitude_5285,
    "uvc": fakesysfs.single_uvc,
    "mixed": fakesysfs.ipu3_plus_uvc,
    "empty": fakesysfs.empty,
}


FAKE_VIEWER = os.path.join(REPO, "tests", "fake-viewer", "avincecam-fake-viewer")
FAKE_CAM = os.path.join(REPO, "tests", "fake-cam", "avincecam-fake-cam")


def fake_runtime_dir():
    """Lock and log folder of the fake previews (never the real one)."""
    path = os.environ.get("AVINCECAM_FAKE_RUNTIME") or os.path.join(
        tempfile.gettempdir(), f"avincecam-fake-{os.getuid()}")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def run_real_core(build, args):
    command = args[0] if args else None
    runtime = ["--runtime-dir", fake_runtime_dir()]
    if command == "preview":
        # The core replaces itself with the fake viewer, so the simulated
        # sysfs tree must outlive this process: keep it in the runtime folder.
        root = os.path.join(fake_runtime_dir(), "sys")
        if not os.path.isdir(root):
            os.makedirs(root)
            build(root)
        os.environ["AVINCECAM_FAKE_VIEWER"] = FAKE_VIEWER
        return core_main(args + ["--sysfs-root", root] + runtime)
    if command in ("stop", "status"):
        return core_main(args + runtime)
    if command == "snapshot":
        # Fake cam (libcamera) or simulated webcam (USB, D17), fake /dev;
        # photos go to the fake runtime folder, never to ~/Pictures.
        os.environ["AVINCECAM_FAKE_CAM"] = FAKE_CAM
        with tempfile.TemporaryDirectory() as tmp:
            root = os.path.join(tmp, "sys")
            os.makedirs(root)
            build(root)
            import fakeuvc  # noqa: E402
            from avincecam import sysfs, uvcphoto  # noqa: E402
            webcam = [c for c in sysfs.scan(root, ())[0] if c.api == "v4l2"]
            if webcam:
                node = sorted(n for n in webcam[0].nodes if "video" in n)[0]
                uvcphoto.TEST_BACKEND = fakeuvc.FakeUvc(capture_node=os.path.basename(node))
            os.makedirs(os.path.join(tmp, "dev"))
            extra = ["--sysfs-root", root, "--dev-root", tmp,
                     "--out", os.path.join(fake_runtime_dir(), "photos")]
            return core_main(args + extra + runtime)
    if command == "watch":
        # Watches plain files in a temporary folder, never the real /dev.
        with tempfile.TemporaryDirectory() as tmp:
            root = os.path.join(tmp, "sys")
            os.makedirs(root)
            build(root)
            fakesysfs.make_dev(root, tmp)
            return core_main(args + ["--sysfs-root", root, "--dev-root", tmp] + runtime)
    with tempfile.TemporaryDirectory() as tmp:
        root = os.path.join(tmp, "sys")
        ipa = os.path.join(tmp, "ipa")
        os.makedirs(root)
        os.makedirs(ipa)
        build(root)
        extra = ["--sysfs-root", root, "--ipa-dir", ipa]
        if command == "probe":
            extra += ["--tool-output", FIXTURES]
        if command == "scan":
            extra += runtime
        if command in ("scan", "probe"):
            args = args + extra
        return core_main(args)


def main(argv):
    scenario = "latitude"
    args = []
    for arg in argv:
        if arg.startswith("--scenario="):
            scenario = arg.split("=", 1)[1]
        else:
            args.append(arg)

    if scenario in SCENARIOS:
        return run_real_core(SCENARIOS[scenario], args)
    if scenario == "slow":
        time.sleep(30)
        return run_real_core(fakesysfs.latitude_5285, args)
    if scenario == "garbage":
        print("Traceback (most recent call last): not json")
        return 0
    if scenario == "crash":
        print("fake core: simulated crash", file=sys.stderr)
        return 1
    if scenario == "toolmissing":
        if args[:1] != ["probe"]:
            return run_real_core(fakesysfs.latitude_5285, args)
        # The real core without cam: scan data plus the error a probe reports.
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            run_real_core(fakesysfs.latitude_5285, ["scan"])
        data = json.loads(out.getvalue())
        data.update({"command": "probe", "libcamera_calls": 0,
                     "errors": [{"code": "libcamera-tools-missing",
                                 "message": "the libcamera tool 'cam' is not installed",
                                 "detail": None}]})
        print(json.dumps(data))
        return 1
    print(f"unknown scenario {scenario}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
